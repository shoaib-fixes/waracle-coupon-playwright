<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>WaracleStore.CouponTests</RootNamespace>
    <!-- Plain `dotnet test` gets the same worker count and timeouts as CI -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Browser automation + web-first assertions + tracing -->
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />

    <!-- Gherkin features, step bindings, scenario-scoped DI -->
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />

    <!-- Runner -->
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />

    <!-- Readable assertions for computed values -->
    <PackageReference Include="Shouldly" Version="4.3.0" />

    <!-- axe-core accessibility scans on a Playwright page -->
    <PackageReference Include="Deque.AxeCore.Playwright" Version="4.13.0" />

    <!-- Allure results per scenario (steps, attachments, parameters); rendered with `allure generate` -->
    <PackageReference Include="Allure.Reqnroll" Version="2.15.0" />

    <!-- Typed, layered configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="allureConfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
